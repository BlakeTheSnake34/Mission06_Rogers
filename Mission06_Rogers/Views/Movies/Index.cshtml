@model List<Movie>

<h2 class="mt-3">Movie Collection</h2>

<table class="table table-striped table-hover table-bordered mt-3">
    <thead class="table-dark">
    <tr>
        <th>Title</th>
        <th>Year</th>
        <th>Edited</th>
        <th>Copied To Plex</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.Title</td>
            <td>@m.Year</td>
            <td>@m.Edited</td>
            <td>@m.CopiedToPlex</td>
            <td class="text-end">
                <a class="btn btn-sm btn-primary"
                   asp-controller="Movies"
                   asp-action="Edit"
                   asp-route-id="@m.MovieId">Edit</a>

                <a class="btn btn-sm btn-danger"
                   asp-controller="Movies"
                   asp-action="Delete"
                   asp-route-id="@m.MovieId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>