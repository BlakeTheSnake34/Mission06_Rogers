@model Mission06_Rogers.Models.Movie

@{
    ViewData["Title"] = "Edit Movie";
}

<h1 class="mt-3">Edit Movie</h1>

<form asp-action="Edit" method="post" class="mt-3">
    <input type="hidden" asp-for="MovieId" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Year" class="form-label"></label>
        <input asp-for="Year" class="form-control" />
        <span asp-validation-for="Year" class="text-danger"></span>
        <div class="form-text">Year must be 1888 or later.</div>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Edited" class="form-check-input" />
        <label asp-for="Edited" class="form-check-label"></label>
        <span asp-validation-for="Edited" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="CopiedToPlex" class="form-check-input" />
        <label asp-for="CopiedToPlex" class="form-check-label"></label>
        <span asp-validation-for="CopiedToPlex" class="text-danger"></span>
    </div>

    <button class="btn btn-success" type="submit">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}